# Copy this file to .env and fill in the values before starting the server.

# HTTP port the server listens on (default: 3000)
PORT=3000

# REQUIRED: Secret used to sign and verify JWT access tokens.
# Must be a long, random string. Generate with: openssl rand -hex 32
JWT_SECRET=

# JWT token lifetime (default: 1h). Accepts zeit/ms format: 15m, 1h, 7d, etc.
JWT_EXPIRY=1h

# Issuer claim embedded in every JWT (default: onprem-api)
JWT_ISSUER=onprem-api

# OAuth client credentials — the single registered service account.
# For multiple clients, replace clients.js with a database-backed registry.
OAUTH_CLIENT_ID=my-service
OAUTH_CLIENT_SECRET=
