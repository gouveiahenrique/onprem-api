# Copy this file to .env and fill in real values before starting the server.

# Secret used to sign JWTs. Must be at least 32 characters. Keep private.
JWT_SECRET=replace-this-with-a-long-random-secret-value

# Token lifetime in seconds (default: 3600 = 1 hour).
TOKEN_EXPIRY_SECONDS=3600

# Pre-registered OAuth client credentials.
# Add more clients by extending config/clients.js.
CLIENT_ID=my-service
CLIENT_SECRET=my-secret

# Port the server listens on (default: 3000).
PORT=3000
